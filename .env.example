# --- database -------------------------------------------------------------
# docker compose up -d gives you this exact URL locally.
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexuslive?schema=public"

# --- auth -----------------------------------------------------------------
# 32+ random bytes. openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime for the httpOnly cookie.
SESSION_TTL_HOURS="168"

# --- the one and only owner account --------------------------------------
# isMasterAdmin() requires role MASTER_ADMIN *and* an exact match on this
# email. Only `npm run db:seed` may create it; no endpoint can grant the role.
MASTER_ADMIN_EMAIL="owner@nexuslive.app"
MASTER_ADMIN_PASSWORD="change-me-before-seeding"
MASTER_ADMIN_USERNAME="owner"

# --- app ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Nexus Live"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

